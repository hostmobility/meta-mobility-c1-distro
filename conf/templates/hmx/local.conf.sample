MACHINE ??= 'imx8mp-var-dart-hmx1'
IMX_DEFAULT_BSP = "mainline"
DISTRO_NAME = "mobility-c1 (Setek Production Distro)"
DISTRO_VERSION = "5.0"
DISTRO_CODENAME = "scarthgap"
TCLIBCAPPEND = ""

INIT_MANAGER = "systemd"

# Complete feature list, init-manager-systemd.inc adds systemd and usrmerge.
# Headless, no wifi, bluetooth or NFC, modem handled by wvdial/pppd (not ofono).
DISTRO_FEATURES = "\
    xattr pam seccomp \
    ipv4 ipv6 zeroconf \
    usbhost usbgadget pci \
    ext2 vfat \
"

# What poky.conf provided that is worth keeping
require conf/distro/include/security_flags.inc
require conf/distro/include/no-static-libs.inc
require conf/distro/include/yocto-uninative.inc
INHERIT += "uninative"
BB_SIGNATURE_HANDLER = "OEEquivHash"
BB_HASHSERVE ??= "auto"

PACKAGE_CLASSES ?= 'package_ipk'
EXTRA_IMAGE_FEATURES ?= "debug-tweaks package-management"
USER_CLASSES = "buildstats"
INHERIT += "rm_work deploy_mobility buildhistory"
BUILDHISTORY_COMMIT ?= "1"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# sensord (disabled by its preset) pulls in rrdtool with cairo, pango and fonts
PACKAGECONFIG:remove:pn-lmsensors = "sensord"

# opkg-utils' python scripts (opkg-make-index, opkg-show-deps, ...) build
# feeds on a host, opkg does not need them. Keeps python3 out of the image.
PACKAGECONFIG:remove:pn-opkg-utils = "python"

CONF_VERSION = "2"
ACCEPT_FSL_EULA = "1"

LICENSE_FLAGS_ACCEPTED = "commercial"

# Path kept from the fslc-xwayland builds so existing units keep their feed
#Use default (DISTRO_FEED_PREFIX += "remote")
DISTRO_FEED_URI += "https://hostmobility.org/fslc-xwayland/${DISTRO_CODENAME}"
DISTRO_FEED_ARCHS += "all ${PACKAGE_EXTRA_ARCHS} ${MACHINE_ARCH}"

ERROR_QA:remove = "version-going-backwards"

DL_DIR ?= "${BSPDIR}/downloads/"
# meta-imx scarthgap append targets OpenSSL 3.2, but this build uses OpenSSL 3.5.
BBMASK += ".*/meta-imx-bsp/recipes-connectivity/openssl/openssl_3\.2\.%\.bbappend"
