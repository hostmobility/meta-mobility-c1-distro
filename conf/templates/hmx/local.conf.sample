MACHINE ??= 'imx8mp-var-dart-hmx1'
TARGET_ARCH ?= "arm"
DISTRO ?= 'fslc-xwayland'
IMX_DEFAULT_BSP = "mainline"
PACKAGE_CLASSES ?= 'package_ipk'
EXTRA_IMAGE_FEATURES ?= "debug-tweaks package-management"
USER_CLASSES = "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

PACKAGECONFIG:append:pn-qemu-system-native = " sdl"
PACKAGECONFIG:append:pn-nativesdk-qemu = " sdl"

CONF_VERSION = "2"
ACCEPT_FSL_EULA = "1"

INHERIT += "rm_work deploy_mobility"

DISTRO_FEATURES:append = " systemd"
DISTRO_FEATURES:append = " usrmerge"
VIRTUAL-RUNTIME_init_manager = "systemd"
DISTRO_FEATURES_BACKFILL_CONSIDERED = "sysvinit"
VIRTUAL-RUNTIME_initscripts = ""
DISTRO_FEATURES:remove = " sysvinit"

LICENSE_FLAGS_ACCEPTED = "commercial"

#Use default (DISTRO_FEED_PREFIX += "remote")
PACKAGECONFIG:append:pn-opkg = " ssl"
DISTRO_FEED_URI += "https://hostmobility.org/${DISTRO}/${DISTRO_CODENAME}"
DISTRO_FEED_ARCHS += "all ${PACKAGE_EXTRA_ARCHS} ${MACHINE_ARCH}"

ERROR_QA:remove = "version-going-backwards"

# Pin the rootfs ext4 feature set: build WITHOUT the e2fsprogs-1.47 defaults
# orphan_file and metadata_csum_seed (defense-in-depth, matches Kirkstone's
# on-disk format). Primary corruption fix is mb_optimize_scan=0 in the hmx
# fstab. Uses a custom wks (meta-hostmobility-bsp/wic/) since wic ignores
# EXTRA_IMAGECMD for its internal mkfs.ext4.
WKS_FILE:imx8mp-var-dart-hmx1 = "hmx-imx-boot-singlepart.wks.in"

DL_DIR ?= "${BSPDIR}/downloads/"
# meta-imx scarthgap append targets OpenSSL 3.2, but this build uses OpenSSL 3.5.
BBMASK += ".*/meta-imx.*/recipes-connectivity/openssl/openssl_3\.2\..*\.bbappend"
